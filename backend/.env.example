# Backend server
PORT=3001
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string

# MariaDB / MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=wca

# WCA OAuth application
WCA_ORIGIN=https://www.worldcubeassociation.org
WCA_CLIENT_ID=your-wca-oauth-client-id
WCA_CLIENT_SECRET=your-wca-oauth-client-secret

# Seconds a user query on /api/query may run before the database kills it (default 60)
QUERY_TIMEOUT_SECONDS=60

# Megabytes a statistics query may use for temporary tables, sorts and join buffers
# before MariaDB spills them to disk (default 256, clamped to 16-4096). Applied per
# statement, so the pool can run several at once.
STATISTICS_MEMORY_MB=256
