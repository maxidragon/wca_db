# Backend server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
# Static bearer token accepted alongside the WCA login, for GET requests only (any other method
# answers 403). It has no WCA user behind it. Leave it empty to disable it.
SERVICE_TOKEN=

# MariaDB / MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=wca

# Read-only user the Query Tool (/api/query, /api/schema) runs user-written SQL as. Create it
# with ./create_query_user.sh, which grants it SELECT on DB_NAME and nothing else. It must
# not be DB_USER or root; without it the Query Tool answers 503.
QUERY_DB_USER=wca_query
QUERY_DB_PASS=replace-with-a-long-random-string
# Host part of the query user's account, as the database server sees the backend (default localhost)
# QUERY_DB_USER_HOST=localhost

# WCA OAuth application
WCA_ORIGIN=https://www.worldcubeassociation.org
WCA_CLIENT_ID=your-wca-oauth-client-id
WCA_CLIENT_SECRET=your-wca-oauth-client-secret

# Seconds a user query on /api/query may run before the database kills it (default 60)
QUERY_TIMEOUT_SECONDS=60

# Megabytes a statistics query may use for its temporary table before MariaDB spills it
# to disk (default 64, clamped to 16-1024). Charged per statement and the pool runs ten
# at once, so budget for ten times this. 32 already buys nearly all of the speed; raise
# it only on a host with memory to spare.
STATISTICS_MEMORY_MB=64
